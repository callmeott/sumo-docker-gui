# Configuration for sumo-docker-gui.
#
# To use: copy this file to ".env" in the same folder, then edit the values.
#
#     cp env.sample .env
#
# Docker Compose reads ".env" automatically the next time you run
# "docker compose up -d".

# ---------------------------------------------------------------------------
# The folder on your Mac where your SUMO files live (networks, .sumocfg, ...).
# Inside netedit / sumo-gui this folder appears as "/data".
# Example: a file at ~/Sumo/mynet.net.xml is opened as /data/mynet.net.xml
SUMO_DATA=~/Sumo

# ---------------------------------------------------------------------------
# Size of the virtual screen the applications run on. Bigger = sharper on
# large/retina displays, at a small performance cost.
#SCREEN=2560x1440

# ---------------------------------------------------------------------------
# Font used for all application UI text. The default covers Latin, Chinese,
# Japanese and Korean. Thai users who don't need CJK menus can use e.g. Loma.
#UI_FONT=Noto Sans CJK SC

# ---------------------------------------------------------------------------
# NOTE: SUMO_HOME is NOT used by this Docker setup (the container has its own
# SUMO installation). SUMO_HOME belongs in your ~/.zshrc / ~/.bash_profile on
# the Mac itself, for running SUMO's command-line tools natively — see the
# README, step 2. Shown here only for reference:
#SUMO_HOME=/Library/Frameworks/EclipseSUMO.framework/Versions/Current/EclipseSUMO/share/sumo
